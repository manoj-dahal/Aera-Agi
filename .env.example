# ─────────────────────────────────────────────────
# AERA AGI — Environment Configuration (example)
# Copy to .env and fill in real values. Never commit .env
# ─────────────────────────────────────────────────

# Core
AERA_ENV=development
AERA_HOST=0.0.0.0
AERA_PORT=8000
AERA_LOG_LEVEL=info
AERA_SECRET_KEY=change-me

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Database
DATABASE_URL=sqlite:///./data/aera.db
# DATABASE_URL=postgresql://aera:aera@localhost:5432/aera
REDIS_URL=redis://localhost:6379/0

# Memory Graph
MEMORY_GRAPH_BACKEND=sqlite
VECTOR_STORE=chromadb
VECTOR_STORE_PATH=./storage/vectors

# Local LLM (Local First)
LOCAL_LLM_ENABLED=true
OLLAMA_HOST=http://localhost:11434
LOCAL_MODEL_DEFAULT=llama3

# Cloud AI Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Voice System
STT_ENGINE=whisper
TTS_ENGINE=piper
VOICE_LANGUAGE=en

# Security
JWT_SECRET=change-me-too
JWT_EXPIRES_IN=86400
ZERO_TRUST_MODE=true
