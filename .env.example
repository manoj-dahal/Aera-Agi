# AERA — Artificial Enhanced Reasoning Assistant

# Copy to .env and fill in what you use. Everything is optional:
# AERA runs fully offline on the built-in reasoner with no keys at all.

# --- Cloud AI providers -------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Config overrides (AERA_<SECTION>__<FIELD>) --------------------------
# AERA_API__PORT=8080
# AERA_SYSTEM__ENVIRONMENT=production
# AERA_MODELS__ROUTING_MODE=local_first
# AERA_MODELS__LOCAL__ENDPOINT=http://localhost:11434
# AERA_LOGGING__LEVEL=DEBUG
# AERA_API__AUTH_ENABLED=true
